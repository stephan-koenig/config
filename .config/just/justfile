# List global recipes
@default:
  just -g --list

# Build PrairieLearn workspace with uv and marimo
[group('Docker')]
build-workspace uv='0.8.22':
  @echo 'Building PrairieLearn workspace with uv version {{uv}}...'
  @docker build --platform linux/amd64 \
    --build-arg UV_VERSION={{uv}} \
    -t stephankoenig/workspace-marimo:uv-{{uv}} \
    "$HOME/Documents/github/pl-ubc-cpsc203/workspaces/marimo"

alias bw := build-workspace

# Build PrairieLearn grader with marimo
[group('Docker')]
build-grader marimo='0.16.4':
  @echo 'Building PrairieLearn grader with marimo version {{marimo}}...'
  @docker build --platform linux/amd64 \
    --build-arg MARIMO_VERSION={{marimo}} \
    -t stephankoenig/marimo-grader:marimo-{{marimo}} \
    "$HOME/Documents/github/pl-ubc-cpsc203/graders/marimo"

alias bg := build-grader

# Add and squash fix for provided commit-hash
[group('Git')]
add-and-squash-fix commit-hash:
  git commit --fixup {{commit-hash}}
  git -c sequence.editor=: rebase --autosquash --interactive {{commit-hash}}~

alias as := add-and-squash-fix

# Start interactive rebase from provided commit-hash
[group('Git')]
interactive-rebase commit-hash:
  git rebase --interactive {{commit-hash}}~

alias ir := interactive-rebase

# Run PrairieLearn with workspaces and autograder for provided course
[group('PrairieLearn')]
run-prairielearn course='cpsc203':
  @echo 'Using {{course}} for PrairieLearn.'
  @mkdir -p "$HOME/Library/Cache/PrairieLearn/pl-ag-jobs"

  @docker run -it --rm --platform linux/amd64 -p 3000:3000 \
    -v "$HOME/.config/prairielearn/config.json:/PrairieLearn/config.json" \
    -v "$HOME/Documents/github/pl-ubc-{{course}}:/course" \
    -v "$HOME/Library/Cache/PrairieLearn/pl-ag-jobs:/jobs" \
    -e HOST_JOBS_DIR="$HOME/Library/Cache/PrairieLearn/pl-ag-jobs" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    --add-host=host.docker.internal:host-gateway \
    --name prairielearn \
    prairielearn/prairielearn

alias pl := run-prairielearn
