# List global recipes
@default:
  just -g --list

alias as := add-and-squash-fix

# Add and squash fix for provided commit-hash 
add-and-squash-fix commit-hash:
  git commit --fixup {{commit-hash}}
  git -c sequence.editor=: rebase --autosquash --interactive {{commit-hash}}~

alias ir := interactive-rebase

# Start interactive rebase from provided commit-hash
interactive-rebase commit-hash:
  git rebase --interactive {{commit-hash}}~
