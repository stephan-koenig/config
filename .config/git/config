[alias]
    can = commit --amend --no-edit
    conf = config --global --edit
    fixup = commit --fixup
    lol = log --all --graph --format='format:%C(bold blue)%h %C(reset)- %s %C(auto)%d%C(reset)'
    lop = log --all --graph --format='format:%w(0,2,6)%C(bold blue)%h %C(reset)- %C(bold cyan)%aD %C(bold yellow)(%ar)%C(auto)%d%n%s%C(dim white) - %an%C(reset)'
    st = status --short
[branch]
    sort = -committerdate
[color]
    ui = auto
    branch = auto
    diff = auto
    status = auto
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[column]
    ui = auto
[commit]
    gpgsign = true
[core]
    editor = "$EDITOR"
    pager = delta
[credential]
    helper =
    helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/op plugin run -- gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/op plugin run -- gh auth git-credential
[credential "https://dev.azure.com"]
    useHttpPath = true
[delta]
    navigate = true
    side-by-side = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[fetch]
    prune = true
    pruneTags = true
    all = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[gpg]
    format = ssh
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    allowedSignersFile = ~/.ssh/allowed_signers
[help]
    autocorrect = prompt
[init]
    defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[merge]
    tool = smerge
    conflictStyle = zdiff3
[mergetool "smerge"]
    cmd = smerge mergetool "$BASE" "$LOCAL" "$REMOTE" -o "$MERGED"
    trustExitCode = true
[pull]
    ff = only
[push]
    autoSetupRemote = true
    default = simple
    followTags = true
[rebase]
    autosquash = true
    autoStash = true
    updateRefs = true
[rerere]
    enabled = true
    autoupdate = true
[tag]
    forceSignAnnotated = true
    sort = version:refname
[user]
    name = Stephan Koenig
    email = stephan.koenig@gmail.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAQpxAxU27JhB5GdDRLLU9Qorp8FLZSOvhBPD2eaMIHS
