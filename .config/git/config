[alias]
    an = commit --amend --no-edit
    at = blame -wMCCC
    au = add --update
    conf = config --global --edit
    d = diff
    ds = diff --staged
    fix = commit --fixup
    fl = log --format='format:%C(bold blue)%h %C(reset)- %s %C(auto)%d%C(reset)' --follow --
    flp = log --format='format:%C(bold blue)%h %C(reset)- %s %C(auto)%d%C(reset)' --follow -p --
    l = log --all --graph --format='format:%C(bold blue)%h %C(reset)- %s %C(auto)%d%C(reset)'
    lp = log --all --graph --format='format:%w(0,2,6)%C(bold blue)%h %C(reset)- %C(bold cyan)%aD %C(bold yellow)(%ar)%C(auto)%d%n%s%C(dim white) - %an%C(reset)'
    pat = add --patch
    ir = rebase --interactive
    sq = -c sequence.editor=: rebase --autosquash --interactive
    st = status --short
    us = restore --staged
[branch]
    sort = -committerdate
[color]
    ui = auto
    branch = auto
    diff = auto
    status = auto
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[column]
    ui = auto
[commit]
    gpgsign = true
    verbose = true
[core]
    editor = "$EDITOR"
    pager = delta
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/op plugin run -- gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/op plugin run -- gh auth git-credential
[delta]
    navigate = true
    side-by-side = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    tool = positron
[difftool "positron"]
    cmd = positron --wait --diff $LOCAL $REMOTE
[fetch]
    prune = true
    pruneTags = true
    all = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[gpg]
    format = ssh
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    allowedSignersFile = ~/.ssh/allowed_signers
[help]
    autocorrect = prompt
[init]
    defaultBranch = main
[interactive]
    diffFilter = delta --color-only
[merge]
    tool = positron
    conflictStyle = zdiff3
[mergetool "positron"]
    cmd = positron --wait --merge $REMOTE $LOCAL $BASE $MERGED
    trustExitCode = true
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    default = simple
    followTags = true
[rebase]
    autosquash = true
    autoStash = true
    updateRefs = true
[remote "origin"]
	fetch = ^refs/heads/gh-pages
[rerere]
    enabled = true
    autoupdate = true
[tag]
    forceSignAnnotated = true
    sort = version:refname
[user]
