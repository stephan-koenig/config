{
    "console.fontSize": 18,
    "dev.containers.enable": true,
    "editor.accessibilitySupport": "off",
    "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', Monaco, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 18,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.rulers": [
        80
    ],
    "explorer.confirmDelete": false,
    "files.associations": {
        "renv.lock": "json"
    },
    "files.watcherExclude": {
        "**/_book/**": true,
        "**/_freeze/**": true,
        "**/_manuscript/**": true,
        "**/_site/**": true,
        "**/.quarto/**": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "notebook.formatOnSave.enabled": true,
    "projectManager.git.baseFolders": [
        "~/Documents/github"
    ],
    "python.interpreters.exclude": [
        "/usr",
        "~/.local",
        "/opt/homebrew"
    ],
    "quarto.render.renderOnSave": true,
    "quarto.visualEditor.markdownWrap": "sentence",
    "quarto.visualEditor.spellingDictionary": "en_CA",
    "quarto.visualEditor.lineNumbers": false,
    "search.exclude": {
        "*/_book": true,
        "*/_freeze": true,
        "*/_manuscript": true,
        "*/_site": true,
        "*/.quarto": true
    },
    "search.quickOpen.includeSymbols": true,
    "terminal.external.osxExec": "Ghostty.app",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 18,
    "window.autoDetectColorScheme": true,
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[quarto]": {
        "editor.defaultFormatter": "quarto.quarto",
        "editor.formatOnSave": true,
        "editor.guides.bracketPairs": "active"
    },
    "[r]": {
        "editor.defaultFormatter": "Posit.air-vscode",
        "editor.formatOnSave": true
    }
}
