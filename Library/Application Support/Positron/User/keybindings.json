// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+1",
        "command": "-workbench.action.openEditorAtIndex1"
    },
    {
        "key": "ctrl+2",
        "command": "-workbench.action.openEditorAtIndex2"
    },
    {
        "key": "ctrl+3",
        "command": "-workbench.action.openEditorAtIndex3"
    },
    {
        "key": "ctrl+4",
        "command": "-workbench.action.openEditorAtIndex4"
    },
    {
        "key": "ctrl+5",
        "command": "-workbench.action.openEditorAtIndex5"
    },
    {
        "key": "ctrl+6",
        "command": "-workbench.action.openEditorAtIndex6"
    },
    {
        "key": "ctrl+7",
        "command": "-workbench.action.openEditorAtIndex7"
    },
    {
        "key": "ctrl+8",
        "command": "-workbench.action.openEditorAtIndex8"
    },
    {
        "key": "ctrl+9",
        "command": "-workbench.action.openEditorAtIndex9"
    },
    {
        "key": "cmd+k e",
        "command": "-workbench.files.action.focusOpenEditorsView",
        "when": "workbench.explorer.openEditorsView.active"
    },
    {
        "key": "cmd+k f",
        "command": "-workbench.action.positronConsole.focusConsole"
    },
    {
        "key": "ctrl+1",
        "command": "workbench.action.focusActiveEditorGroup"
    },
    {
        "key": "ctrl+2",
        "command": "workbench.action.positronConsole.open"
    },
    {
        "key": "ctrl+3",
        "command": "workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+`",
        "command": "-workbench.action.terminal.toggleTerminal",
        "when": "terminal.active"
    },
    {
        "key": "ctrl+4",
        "command": "workbench.action.positron.openHelp",
        "when": "workbench.panel.positronHelp.active"
    },
    {
        "key": "shift+cmd+h",
        "command": "-workbench.action.positron.openHelp",
        "when": "workbench.panel.positronHelp.active"
    },
    {
        "key": "shift+cmd+h",
        "command": "-workbench.action.positron.togglePreview",
        "when": "workbench.panel.positronPreview.active"
    },
    {
        "key": "ctrl+5",
        "command": "workbench.action.positron.toggleHistory"
    },
    {
        "key": "ctrl+6",
        "command": "workbench.action.positron.togglePreview"
    },
    {
        "key": "ctrl+7",
        "command": "workbench.action.positron.toggleVariables",
        "when": "workbench.panel.positronVariables.active"
    },
    {
        "key": "shift+cmd+h",
        "command": "-workbench.action.positron.toggleVariables",
        "when": "workbench.panel.positronVariables.active"
    },
    {
        "key": "ctrl+8",
        "command": "workbench.action.positron.togglePlots"
    }
]
